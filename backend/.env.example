# Clé API Claude (vision)
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour lire les compteurs (vision)
CLAUDE_MODEL=claude-sonnet-5

# Postgres (Railway le fournit automatiquement en variable DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/feuille_vehicule

# Nom du chauffeur affiché sur la feuille véhicule (MVP = un seul chauffeur, pas de sélection)
DRIVER_NAME=Chauffeur

# Immatriculation affichée en en-tête de la feuille véhicule (MVP = un seul camion)
TRUCK_PLATE=GC-506-VT

# Dossier où sont stockés les PDF générés (monter un volume Railway sur ce chemin en prod)
PDF_STORAGE_DIR=./data/pdfs

# Origine autorisée pour le CORS (URL du frontend Vercel)
CORS_ORIGIN=http://localhost:5173

# Port HTTP (Railway le fournit automatiquement)
PORT=3000

# Authentification (voir README pour la procédure de création/rotation du compte)
# Secret de signature des tokens de session : fixe et privé en prod (générer avec `openssl rand -hex 32`).
# Un secret aléatoire est généré à chaque démarrage si absent, pratique en local mais invalide les
# sessions à chaque redémarrage — ne pas laisser vide en prod.
AUTH_SECRET=
# Ces deux variables ne créent le compte qu'une fois (si le username n'existe pas encore en base) :
# les modifier après coup ne change PAS le mot de passe existant. Pour changer le mot de passe d'un
# compte existant, il faut le faire directement en base (pas d'endpoint self-service, volontairement).
SEED_USERNAME=
SEED_PASSWORD=
