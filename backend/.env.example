# Clé API Claude (vision)
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour lire les compteurs (vision)
CLAUDE_MODEL=claude-sonnet-5

# Postgres (Railway le fournit automatiquement en variable DATABASE_URL)
DATABASE_URL=postgres://user:password@localhost:5432/feuille_vehicule

# Nom du chauffeur affiché sur la feuille véhicule (MVP = un seul chauffeur, pas de sélection)
DRIVER_NAME=Chauffeur

# Immatriculation affichée en en-tête de la feuille véhicule (MVP = un seul camion)
TRUCK_PLATE=GC-506-VT

# Dossier où sont stockés les PDF générés (monter un volume Railway sur ce chemin en prod)
PDF_STORAGE_DIR=./data/pdfs

# Origine autorisée pour le CORS (URL du frontend Vercel)
CORS_ORIGIN=http://localhost:5173

# Port HTTP (Railway le fournit automatiquement)
PORT=3000
